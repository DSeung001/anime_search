# anime_search 환경 변수 (권장: export 대신 이 파일만 사용)
# 1) cp .env.example .env
# 2) 아래 값 편집
# 3) runserver·celery worker 재시작

# --- 데이터 경로 ---
# ANIME_DATA_ROOT=          # 기본: <프로젝트>/data (staging/, media/)
# S3_MEDIA_PREFIX=          # 객체 스토어 prefix (선택)

# --- Qdrant (임베딩·검색) ---
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=           # 클라우드 Qdrant 시
# QDRANT_COLLECTION=anime_clip

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=    # 비우면 CELERY_BROKER_URL과 동일
# CELERY_TASK_TIME_LIMIT=3600
# CELERY_WORKER_CONCURRENCY=1
# CELERY_TASK_ALWAYS_EAGER= # 1/true: worker 없이 동기(로컬 테스트)

# --- CLIP / 임베딩 ---
# CLIP_MODEL_NAME=ViT-L/14
# CLIP_CHECKPOINT=          # 절대경로 .pt (비우면 weights/ViT-L-14.pt 또는 다운로드)
# CLIP_DOWNLOAD_ROOT=
# CLIP_SSL_NO_VERIFY=       # 1: TLS 검증 끔 (다운로드 문제 시만)
# ANIME_EMBED_BATCH_SIZE=64
# ANIME_EMBED_NUM_WORKERS=0
# ANIME_EMBED_DEVICE=       # auto | cpu | cuda | mps (미설정: macOS=cpu)

# --- 동영상 → 프레임 (ffmpeg) ---
# FFMPEG_BIN=               # 비우면 imageio-ffmpeg 동봉 바이너리 (프레임 추출·YouTube yt-dlp 병합)
# FFPROBE_BIN=
# VIDEO_EXTRACT_FPS=1      # 기본 1 (초당 1장). 0 이하: 전 프레임. Qdrant timestamp_sec = frame_index / 이 값
# VIDEO_EXTRACT_MAX_FRAMES=0
# VIDEO_EXTRACT_JPEG_Q=2

# --- Discovery (공개 /search/ 채팅) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# SEARCH_CELERY_TIMEOUT_SEC=120
# SEARCH_RATE_LIMIT_PER_MIN=20
# CHAT_MAX_HISTORY=20
# SEARCH_QUERY_TRANSLATE_ENABLED=true
# DISCOVERY_PROTECT_DONE_JOBS=true
# SEGMENT_MERGE_GAP_SEC=1.5
# SEARCH_MIN_SCORE=0.2
# SEARCH_MAX_SCENES=12
# SEARCH_MERGE_MAX_SEGMENTS=12
# PIPELINE_TRACE_ENABLED=true
# PIPELINE_TRACE_LOG_TOP_HITS=10

# --- API / 업로드 ---
# EMBED_INTERNAL_KEY=       # DEBUG=False 시 내부 embed API 보호
# FILE_UPLOAD_MAX_MEMORY_SIZE=524288000
# YOUTUBE_MAX_DURATION_SEC=7200   # YouTube 가져오기 최대 길이(초), 0=제한 없음 (병합: FFMPEG_BIN/imageio-ffmpeg)
